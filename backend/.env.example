# Copy to backend/.env. All values are read server-side only and never sent to the browser.

# SQLite (default, zero setup) or PostgreSQL (see docker-compose.yml; requires `uv sync --extra postgres`)
OSINT_DATABASE_URL=sqlite+aiosqlite:///./osint.db
# OSINT_DATABASE_URL=postgresql+asyncpg://osint:osint@localhost:5432/osint

# Optional shared bearer token. When set, the console asks for it on the Settings page.
# OSINT_API_TOKEN=

# Optional official-API credentials. Without them the matching sources report
# "Requires auth" instead of being scraped.
# OSINT_GITHUB_TOKEN=            # raises GitHub's anonymous rate limit
# OSINT_REDDIT_CLIENT_ID=        # https://www.reddit.com/prefs/apps (script/app-only)
# OSINT_REDDIT_CLIENT_SECRET=
# OSINT_YOUTUBE_API_KEY=         # YouTube Data API v3
# OSINT_X_BEARER_TOKEN=          # X API v2
# OSINT_BRAVE_SEARCH_API_KEY=    # Brave Search API (web discovery)

# Limits
# OSINT_MAX_CONCURRENT_INVESTIGATIONS=4
# OSINT_CREATE_RATE_LIMIT_PER_MINUTE=10
# OSINT_MAX_PIVOT_WEBSITES=3
# OSINT_MAX_DOCUMENTS=3
