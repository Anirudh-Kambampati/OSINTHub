# Local development configuration. Copy to backend/.env. Read server-side only.
# (For docker compose, use the .env.example at the repository root.)

# SQLite (default, zero setup) or PostgreSQL (`uv sync --extra postgres`)
OSINT_DATABASE_URL=sqlite+aiosqlite:///./osint.db
# OSINT_DATABASE_URL=postgresql+asyncpg://osint:osint@localhost:5432/osint

# "production" enables Secure cookies and disables the interactive API docs.
OSINT_ENVIRONMENT=development

# Email or URL identifying you to sources (sent in the User-Agent). Required by Wikidata.
# OSINT_OPERATOR_CONTACT=you@example.org

# Accounts: the first account becomes admin; afterwards admins create users.
# OSINT_ALLOW_REGISTRATION=false
# OSINT_SESSION_TTL_HOURS=72

# Worker: run investigations inside the API process (single node) or separately
# with `python -m app.worker` (set this to false then).
# OSINT_RUN_WORKER_IN_API=true
# OSINT_MAX_CONCURRENT_INVESTIGATIONS=4

# Delete investigations older than N days.
# OSINT_RETENTION_DAYS=180

# Optional official-API credentials. Without them the matching sources report
# "Requires auth" instead of being scraped.
# OSINT_GITHUB_TOKEN=            # raises GitHub's anonymous rate limit (60/h -> 5000/h)
# OSINT_REDDIT_CLIENT_ID=        # https://www.reddit.com/prefs/apps (app-only)
# OSINT_REDDIT_CLIENT_SECRET=
# OSINT_YOUTUBE_API_KEY=         # YouTube Data API v3
# OSINT_X_BEARER_TOKEN=          # X API v2
# OSINT_BRAVE_SEARCH_API_KEY=    # Brave Search API (web discovery)

# Limits
# OSINT_CREATE_RATE_LIMIT_PER_MINUTE=10
# OSINT_LOGIN_RATE_LIMIT_PER_MINUTE=10
# OSINT_MAX_PIVOT_WEBSITES=3
# OSINT_MAX_PIVOT_IPS=3
# OSINT_MAX_DOCUMENTS=3
