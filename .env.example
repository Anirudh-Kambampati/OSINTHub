# docker compose configuration. Copy to .env and edit. Never commit .env.

# Database password used by the bundled PostgreSQL service.
OSINT_DB_PASSWORD=change-me-to-a-long-random-string

# Email or URL identifying you to sources (added to the User-Agent). Required by Wikidata.
OSINT_OPERATOR_CONTACT=

# Host port for the console.
OSINT_HTTP_PORT=8080

# Cookies are Secure in production. Browsers accept this on http://localhost; for any other
# host, serve the console over HTTPS (recommended) or set this to false.
# OSINT_COOKIE_SECURE=true

# Optional official-API credentials (sources stay "Requires auth" without them).
# OSINT_GITHUB_TOKEN=
# OSINT_REDDIT_CLIENT_ID=
# OSINT_REDDIT_CLIENT_SECRET=
# OSINT_YOUTUBE_API_KEY=
# OSINT_X_BEARER_TOKEN=
# OSINT_BRAVE_SEARCH_API_KEY=

# Delete investigations older than N days (unset = keep forever).
# OSINT_RETENTION_DAYS=180
# OSINT_ALLOW_REGISTRATION=false
